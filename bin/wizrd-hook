#!/usr/bin/env bash
# wizrd hook — manage the wizrd pre-commit hook in the current git repo.
#
# Usage:
#   wizrd-hook install      Install the pre-commit hook (symlink to ~/.wizrd-cli/hooks/pre-commit)
#   wizrd-hook uninstall    Remove the symlink
#   wizrd-hook status       Report whether the hook is installed
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOOK_SRC="$SCRIPT_DIR/hooks/pre-commit"

cmd="${1:-status}"

# Find the git dir (handles worktrees and bare-ish layouts)
GIT_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -z "$GIT_DIR" ] || [ ! -d "$GIT_DIR" ]; then
  echo "Error: not inside a git repository." >&2
  exit 1
fi

HOOK_DST="$GIT_DIR/hooks/pre-commit"

case "$cmd" in
  install)
    mkdir -p "$GIT_DIR/hooks"
    if [ -e "$HOOK_DST" ] && [ ! -L "$HOOK_DST" ]; then
      echo "Error: $HOOK_DST exists and is not a symlink. Move it aside first." >&2
      exit 1
    fi
    ln -sf "$HOOK_SRC" "$HOOK_DST"
    chmod +x "$HOOK_SRC"
    echo "Installed: $HOOK_DST -> $HOOK_SRC"
    ;;
  uninstall)
    if [ -L "$HOOK_DST" ]; then
      rm "$HOOK_DST"
      echo "Removed: $HOOK_DST"
    else
      echo "No wizrd hook symlink at $HOOK_DST (nothing to do)"
    fi
    ;;
  status)
    if [ -L "$HOOK_DST" ]; then
      echo "Installed: $HOOK_DST -> $(readlink "$HOOK_DST")"
    elif [ -e "$HOOK_DST" ]; then
      echo "A non-symlink pre-commit hook exists at $HOOK_DST (not managed by wizrd)"
    else
      echo "Not installed"
    fi
    ;;
  *)
    echo "Usage: wizrd-hook {install|uninstall|status}" >&2
    exit 1
    ;;
esac
